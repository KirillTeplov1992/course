package templates

import (
    "course/internal/tasks/models"
    "fmt"    
)

templ TasksPage(tasks []*models.Task) {
    for _, t := range tasks{
        switch t.TypeContent{
        case "title":
            {{ link := fmt.Sprintf("/task?id=%d", t.ID) }}
            <a href = { link }>{ t.Name }</a>
            <br>
        case "task":
            <h2>
            $${ t.Name }$$
            </h2>
            <details>
                <summary>Ответ:</summary>
            <h2>
            ${ t.Answer }$
            </h2>
            </details>
        case "article":
            <h2>
            { t.Name }
            </h2>
        case "task_with_picture":
            <h2>
            $${ t.Name }$$
            </h2>
            <img
                src={ templ.URL(t.PictureURL) }
                alt="Чертеж"
                loading="lazy"/>
            <details>
                <summary>Ответ:</summary>
            <h2>
            ${ t.Answer }$
            </h2>
            </details>
        default:
            <h3>Нифига не понятно</h3> 
        }
    }
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
}